<Window x:Class="Polyclinic.UI.PatientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пациент" 
        Height="540" Width="520" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок формы (Модуль 3: четко отражает операцию) -->
        <TextBlock x:Name="HeaderTextBlock" 
                   Text="Добавление пациента" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource SecondaryBrush}" 
                   Margin="0,0,0,16"/>

        <!-- Поля формы -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- ФИО -->
                <TextBlock Text="ФИО пациента: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="FullNameTextBox" Margin="0,0,0,2" TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="FullNameHint" Text="Пример: Иванов Иван Иванович" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Дата рождения -->
                <TextBlock Text="Дата рождения: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,2" SelectedDateChanged="BirthDatePicker_SelectedDateChanged"/>
                <TextBlock x:Name="BirthDateHint" Text="Выберите дату в календаре (не может быть в будущем)" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Пол -->
                <TextBlock Text="Пол: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <ComboBox x:Name="GenderComboBox" DisplayMemberPath="GenderName" SelectedValuePath="GenderId" Margin="0,0,0,10" SelectionChanged="GenderComboBox_SelectionChanged"/>

                <!-- Номер полиса ОМС -->
                <TextBlock Text="Номер полиса ОМС (16 цифр): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="PolicyNumberTextBox" MaxLength="16" Margin="0,0,0,2" TextChanged="PolicyNumberTextBox_TextChanged"/>
                <TextBlock x:Name="PolicyHint" Text="Ровно 16 цифр полиса ОМС (например: 1234567890123456)" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Телефон -->
                <TextBlock Text="Номер телефона: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="PhoneTextBox" Margin="0,0,0,2" TextChanged="PhoneTextBox_TextChanged"/>
                <TextBlock x:Name="PhoneHint" Text="Формат: +7 (999) 000-00-00" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Email -->
                <TextBlock Text="Электронная почта (Email): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="EmailTextBox" Margin="0,0,0,2" TextChanged="EmailTextBox_TextChanged"/>
                <TextBlock x:Name="EmailHint" Text="Пример: ivanov@mail.ru" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Адрес -->
                <TextBlock Text="Адрес проживания: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="AddressTextBox" Margin="0,0,0,2" TextChanged="Input_TextChanged"/>
                <TextBlock Text="Город, улица, дом, квартира" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
