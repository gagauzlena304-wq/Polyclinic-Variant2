<Window x:Class="Polyclinic.UI.AddAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый приём пациента" 
        Height="540" Width="480" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление приёма пациента" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Врач -->
                <TextBlock Text="Лечащий врач: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <ComboBox x:Name="DoctorComboBox" DisplayMemberPath="FullName" SelectedValuePath="DoctorId" Margin="0,0,0,10"/>

                <!-- Дата и время -->
                <TextBlock Text="Дата приёма: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <DatePicker x:Name="AppointmentDatePicker" Margin="0,0,0,10"/>

                <!-- Жалобы -->
                <TextBlock Text="Жалобы пациента:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="ComplaintsTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <!-- Диагноз -->
                <TextBlock Text="Диагноз: *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="DiagnosisTextBox" Margin="0,0,0,10"/>

                <!-- Назначения -->
                <TextBlock Text="Назначения и рекомендации:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBox x:Name="RecommendationsTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <!-- Стоимость и скидка -->
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Базовая цена (₽): *" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBox x:Name="BaseCostTextBox" Text="1500" TextChanged="BaseCostTextBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Скидка пациента:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock x:Name="DiscountLabel" Text="0%" FontWeight="Bold" FontSize="14" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Итог к оплате -->
                <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,4,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                        <TextBlock Text="Итого к оплате:" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="FinalCostLabel" Text="1500,00 ₽" FontWeight="Bold" FontSize="16" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100" Click="CancelButton_Click"/>
            <Button Content="Сохранить приём" Width="140" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
