<Window x:Class="Polyclinic.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационная система «Поликлиника»" 
        Height="720" Width="1120" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхняя шапка -->
            <RowDefinition Height="64"/>
            <!-- Основная область с вкладками -->
            <RowDefinition Height="*"/>
            <!-- Статусная строка -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Верхняя шапка приложения -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏥" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ПОЛИКЛИНИКА" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Единая медицинская информационная система (ЕМИС)" FontSize="11" Foreground="#BAE6FD"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Система активна | Режим: Администратор" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки системы -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,8">
            <!-- ВКЛАДКА 1: ПАЦИЕНТЫ И ПРИЁМЫ (Модули 2 и 3) -->
            <TabItem Header="👥 Учет пациентов" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления и поиска -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Поиск -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="SearchTextBox" Width="280" Height="32" 
                                         Tag="Поиск по ФИО, полису или телефону..." 
                                         TextChanged="SearchTextBox_TextChanged"/>
                            </StackPanel>

                            <!-- Кнопки действий -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="+ Добавить пациента" Width="160" Click="AddPatientButton_Click"/>
                                <Button Content="✎ Редактировать" Style="{StaticResource SecondaryButton}" Width="140" Click="EditPatientButton_Click"/>
                                <Button Content="📋 История приёмов" Style="{StaticResource SecondaryButton}" Width="150" Click="HistoryButton_Click"/>
                                <Button Content="Удалить" Style="{StaticResource DangerButton}" Width="90" Click="DeletePatientButton_Click"/>
                                <Button Content="🔄" Style="{StaticResource SecondaryButton}" Width="40" ToolTip="Обновить список" Click="RefreshButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Список пациентов -->
                    <DataGrid x:Name="PatientsGrid" Grid.Row="1" MouseDoubleClick="PatientsGrid_MouseDoubleClick" SelectionChanged="PatientsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding PatientId}" Width="45"/>
                            <DataGridTextColumn Header="ФИО пациента" Binding="{Binding FullName}" Width="220"/>
                            <DataGridTextColumn Header="Дата рожд." Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="95"/>
                            <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="65"/>
                            <DataGridTextColumn Header="Пол" Binding="{Binding GenderName}" Width="75"/>
                            <DataGridTextColumn Header="Полис ОМС" Binding="{Binding PolicyNumber}" Width="150"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                            <DataGridTextColumn Header="Визитов за год" Binding="{Binding VisitsLast12Months}" Width="105"/>
                            
                            <!-- Колонка скидки с цветовой индикацией -->
                            <DataGridTemplateColumn Header="Скидка" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                                Background="{Binding CurrentDiscountPercent, Converter={x:Null}}">
                                            <TextBlock Text="{Binding CurrentDiscountPercent, StringFormat={}{0}%}" 
                                                       FontWeight="Bold" 
                                                       Foreground="#0284C7"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: ВРАЧИ И КАБИНЕТЫ (Модуль 1) -->
            <TabItem Header="👨‍⚕️ Врачи поликлиники" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <TextBlock Text="Реестр медицинского персонала и расписания кабинетов поликлиники" FontWeight="SemiBold" FontSize="14" Foreground="#334155"/>
                    </Border>

                    <DataGrid x:Name="DoctorsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DoctorId}" Width="50"/>
                            <DataGridTextColumn Header="ФИО Врача" Binding="{Binding FullName}" Width="250"/>
                            <DataGridTextColumn Header="Специализация" Binding="{Binding SpecializationName}" Width="180"/>
                            <DataGridTextColumn Header="Номер кабинета" Binding="{Binding Cabinet}" Width="130"/>
                            <DataGridTextColumn Header="Контактный телефон" Binding="{Binding Phone}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 3: ПОСТАВКИ МЕДИКАМЕНТОВ (Модуль 4) -->
            <TabItem Header="📦 Поставки партнеров" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Фильтр по партнеру:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="PartnerFilterComboBox" Grid.Column="1" 
                                      DisplayMemberPath="PartnerName" SelectedValuePath="PartnerId" 
                                      SelectionChanged="PartnerFilterComboBox_SelectionChanged"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="+ Зарегистрировать поставку" Width="220" Click="AddDeliveryButton_Click"/>
                                <Button Content="🔄" Style="{StaticResource SecondaryButton}" Width="40" Click="RefreshDeliveriesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DeliveriesGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DeliveryId}" Width="50"/>
                            <DataGridTextColumn Header="Наименование препарата" Binding="{Binding MedicineName}" Width="260"/>
                            <DataGridTextColumn Header="Тип материала" Binding="{Binding MaterialName}" Width="180"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding FormattedQuantity}" Width="110"/>
                            <DataGridTextColumn Header="Дата поставки" Binding="{Binding FormattedDate}" Width="110"/>
                            <DataGridTextColumn Header="Партнер (Поставщик)" Binding="{Binding PartnerName}" Width="200"/>
                            <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 4: КАЛЬКУЛЯТОР МЕДИКАМЕНТОВ (Модуль 4) -->
            <TabItem Header="🧮 Расчет препаратов" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Форма ввода параметров -->
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Расчет потребности в медикаментах на курс" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <!-- product_type_id -->
                            <TextBlock Text="Тип лечения/назначения (product_type_id): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <ComboBox x:Name="CalcTreatmentComboBox" DisplayMemberPath="TypeName" SelectedValuePath="TreatmentTypeId" Margin="0,0,0,10" SelectionChanged="CalcInputs_Changed"/>

                            <!-- material_type_id -->
                            <TextBlock Text="Тип препарата/лекарства (material_type_id): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <ComboBox x:Name="CalcMaterialComboBox" DisplayMemberPath="MaterialName" SelectedValuePath="MaterialTypeId" Margin="0,0,0,10" SelectionChanged="CalcInputs_Changed"/>

                            <!-- quantity -->
                            <TextBlock Text="Количество пациентов (quantity): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBox x:Name="CalcQuantityTextBox" Text="10" Margin="0,0,0,10" TextChanged="CalcInputs_Changed"/>

                            <!-- param1 -->
                            <TextBlock Text="Дозировка на 1 прием/пациента (param1): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBox x:Name="CalcParam1TextBox" Text="200" Margin="0,0,0,10" TextChanged="CalcInputs_Changed"/>

                            <!-- param2 -->
                            <TextBlock Text="Длительность курса в днях (param2): *" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBox x:Name="CalcParam2TextBox" Text="5" Margin="0,0,0,16" TextChanged="CalcInputs_Changed"/>

                            <Button Content="Выполнить расчет потребности" Height="36" Click="CalculateRequirementButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Результаты расчета и формула -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Результаты расчета" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Требуемое количество с учетом брака:" FontSize="13" Foreground="#0369A1"/>
                                    <TextBlock x:Name="CalcResultNumber" Text="11 220 единиц" FontSize="28" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Детализация параметров -->
                            <TextBlock Text="Детализация и параметры формулы:" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="CalcCoeffDetails" Text="• Коэффициент лечения: 1.10&#x0a;• Процент потерь (брак): 2.0%" LineHeight="20" Margin="0,0,0,12"/>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Формула расчета (Модуль 4):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <TextBlock Text="material_per_unit = param1 * param2 * treatment_coefficient" FontFamily="Consolas" Foreground="#0F172A"/>
                                    <TextBlock Text="total = material_per_unit * quantity * (1 + defect_rate)" FontFamily="Consolas" Foreground="#0F172A"/>
                                    <TextBlock Text="return int(total)" FontFamily="Consolas" Foreground="#0F172A" Margin="0,0,0,6"/>
                                    <TextBlock Text="Если параметры неверны или типы не найдены — метод возвращает -1." FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя статусная строка -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock" Text="Готово | База данных подключена" FontSize="11" Foreground="#64748B"/>
                <TextBlock Text="Поликлиника v1.0 | 2026" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
